# Required, browser-safe Supabase configuration. These are public project values,
# not database passwords.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public contact URL and server-side public Storage bucket name used by
# the storefront when product images are added.
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/
# Server-side bucket name. The Phase 4 migration creates this public bucket.
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Server-only upload cap. It must not exceed the Storage bucket's 5 MiB limit.
PRODUCT_IMAGE_MAX_BYTES=5242880

# Server-only Supabase credential. Not used in Phase 2; reserve it for future
# privileged background tasks. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, process-local login abuse control. These defaults are suitable for
# local development. Use a distributed limiter before relying on this control
# across multiple production instances.
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Server-only Paystack test credential. Never prefix it with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=

# Fully qualified server callback, e.g.
# http://localhost:3000/api/payments/paystack/callback
PAYSTACK_CALLBACK_URL=

# Optional: only needed for a future inline Paystack UI
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
